{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "sortImports": {
    "internalPattern": ["~/", "@/", "#", "@shuttle/", "@swirls/looms"]
  },
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva", "twMerge"]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.flox/**",
    "**/.turbo/**",
    "**/.tanstack/**",
    "**/.wrangler/**",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    "bun.lock",
    ".agents/**",
    ".claude/**",
    ".cursor/**"
  ]
}
