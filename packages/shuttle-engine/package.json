{
  "name": "@swirls/shuttle-engine",
  "version": "0.4.0",
  "description": "What a host runs Shuttle's coding sessions on: the run and sandbox Durable Objects, host ports, headless sessions, and the HTTP API in modules to mount",
  "homepage": "https://github.com/ByteSliceHQ/shuttle#readme",
  "bugs": {
    "url": "https://github.com/ByteSliceHQ/shuttle/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteSliceHQ/shuttle.git",
    "directory": "packages/shuttle-engine"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./git/*": {
      "types": "./dist/git/*.d.ts",
      "import": "./dist/git/*.js"
    },
    "./runner-protocol": {
      "types": "./dist/runner-protocol/index.d.ts",
      "import": "./dist/runner-protocol/index.js"
    },
    "./sandbox/bridge/*": {
      "types": "./dist/sandbox/bridge/*.d.ts",
      "import": "./dist/sandbox/bridge/*.js"
    },
    "./sandbox/*": {
      "types": "./dist/sandbox/lib/*.d.ts",
      "import": "./dist/sandbox/lib/*.js"
    },
    "./*": {
      "types": "./dist/engine/*.d.ts",
      "import": "./dist/engine/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/assemble.ts"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "^3.0.35",
    "@cloudflare/sandbox": "^1.0.3",
    "@daytona/sdk": "^0.231.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@pierre/sdk": "^0.1.2",
    "@swirls/looms": "0.20.0",
    "@swirls/shuttle": "0.4.0",
    "ai": "^7.0.0",
    "effect": "4.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shuttle/engine": "workspace:*",
    "@shuttle/git": "workspace:*",
    "@shuttle/runner-protocol": "workspace:*",
    "@shuttle/sandbox": "workspace:*"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  }
}
