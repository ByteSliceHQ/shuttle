{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@shuttle/api": ["../api/dist/index.d.ts"],
      "@shuttle/git/*": ["../git/dist/*.d.ts"],
      "@shuttle/runner-protocol": ["../runner-protocol/dist/index.d.ts"]
    }
  },
  "exclude": [
    "src/**/*.test.ts",
    "bridge/**/*.test.ts",
    "bridge/testing",
    "src/stack-git-fixture.ts",
    "dist"
  ]
}
