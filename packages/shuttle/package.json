{
  "name": "@swirls/shuttle",
  "version": "0.4.0",
  "description": "Shuttle as parts: React components for a development environment built around coding agents, the API contract and run events they speak, and the engine a host runs their sessions on",
  "homepage": "https://github.com/ByteSliceHQ/shuttle#readme",
  "bugs": {
    "url": "https://github.com/ByteSliceHQ/shuttle/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteSliceHQ/shuttle.git",
    "directory": "packages/shuttle"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./core/pulls": {
      "types": "./dist/core/pulls.d.ts",
      "import": "./dist/core/pulls.js"
    },
    "./core/workspace": {
      "types": "./dist/core/workspace.d.ts",
      "import": "./dist/core/workspace.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/ui": {
      "types": "./dist/react/ui.d.ts",
      "import": "./dist/react/ui.js"
    },
    "./react/theme.css": "./dist/react/theme.css",
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./engine/*": {
      "types": "./dist/engine/*.d.ts",
      "import": "./dist/engine/*.js"
    },
    "./git/*": {
      "types": "./dist/git/*.d.ts",
      "import": "./dist/git/*.js"
    },
    "./runner-protocol": {
      "types": "./dist/runner-protocol/index.d.ts",
      "import": "./dist/runner-protocol/index.js"
    },
    "./sandbox/bridge/*": {
      "types": "./dist/sandbox/bridge/*.d.ts",
      "import": "./dist/sandbox/bridge/*.js"
    },
    "./sandbox/*": {
      "types": "./dist/sandbox/lib/*.d.ts",
      "import": "./dist/sandbox/lib/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/assemble.ts"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "^3.0.35",
    "@cloudflare/sandbox": "^1.0.3",
    "@daytona/sdk": "^0.231.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/openapi-client": "1.16.2",
    "@orpc/tanstack-query": "1.16.2",
    "@pierre/diffs": "1.7.0-beta.4",
    "@pierre/highlights": "0.5.1",
    "@pierre/sdk": "^0.1.2",
    "@pierre/words": "0.2.2",
    "@swirls/looms": "0.20.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.1.4",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react-resizable-panels": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shuttle/api": "workspace:*",
    "@shuttle/core": "workspace:*",
    "@shuttle/engine": "workspace:*",
    "@shuttle/git": "workspace:*",
    "@shuttle/react": "workspace:*",
    "@shuttle/runner-protocol": "workspace:*",
    "@shuttle/sandbox": "workspace:*"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  }
}
