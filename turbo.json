{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "OPENROUTER_API_KEY",
    "LOOMS_MODEL",
    "TYPESAFE_AI_API_KEY",
    "JEV_MODEL",
    "SHUTTLE_WORKSPACE_MODE",
    "SHUTTLE_PLAYBOOK_RUN_ID",
    "PATH",
    "FLOX_ENV_CACHE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", ".dev.vars*"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
