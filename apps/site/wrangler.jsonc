{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuttle-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "routes": [{ "pattern": "shuttle.codes", "custom_domain": true }],
  // The page itself. The Worker sees every request first, so it can send plain http to https.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Desktop builds and update metadata, published by .github/workflows/deploy.yml.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "shuttle-releases" }],
  "vars": {
    // Fallback for /download/mac before the first update manifest is published.
    "LATEST_MAC": "Shuttle-0.0.1-arm64.dmg",
  },
}
