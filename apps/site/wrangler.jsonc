{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuttle-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "routes": [{ "pattern": "shuttle.codes", "custom_domain": true }],
  // Writes pages/ into public/ with their code highlighted. Runs before dev and deploy.
  "build": { "command": "bun scripts/build-pages.ts", "watch_dir": "pages" },
  // The page itself. The Worker sees every request first, so it can send plain http to https.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Built desktop apps, uploaded by hand: see README.md.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "shuttle-releases" }],
  "vars": {
    // What /download/mac sends people to. Change it when a new build is uploaded.
    "LATEST_MAC": "Shuttle-0.0.3-arm64.dmg",
  },
}
