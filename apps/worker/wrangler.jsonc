{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuttle",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "LOOMS_MODEL": "anthropic/claude-sonnet-5.5",
    "SHUTTLE_WORKSPACE_MODE": "memory",
    "SHUTTLE_PLAYBOOK_RUN_ID": "shuttle-playbook",
    "SHUTTLE_WORKSPACE_RUN_ID": "shuttle-workspace",
    "SHUTTLE_PULLS_RUN_ID": "shuttle-pulls",
    "SHUTTLE_WEB_URL": "http://127.0.0.1:5180",
    // Hostname used for container preview iframes (`p3000-<folderId>.<host>`).
    // Locally, `*.localhost` resolves to loopback. A deployment replaces this with the domain of
    // its wildcard route (see `scripts/deploy-config.ts`), so previews load in a visitor's browser.
    "SHUTTLE_PREVIEW_HOST": "localhost",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOOMS_RUN",
        "class_name": "LoomsRun",
      },
      {
        "name": "SANDBOX",
        "class_name": "SessionSandbox",
      },
      {
        "name": "EVENT_FIREHOSE",
        "class_name": "EventFirehose",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LoomsRun", "SessionSandbox"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EventFirehose"],
    },
  ],
  // Accounts, organizations and sign-in sessions. Local dev creates this database on its own and
  // `bun run dev` applies the migrations. To deploy, create it with
  // `wrangler d1 create shuttle-auth`, paste its id here, then run
  // `wrangler d1 migrations apply AUTH_DB --remote`.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "shuttle-auth",
      "database_id": "68cc444b-be05-4567-870f-507722ea5e4a",
      "migrations_dir": "migrations",
    },
    // Optional: cross-run session lists and history tools. Create it with
    // `wrangler d1 create looms-shuttle-replica` and uncomment:
    // {
    //   "binding": "REPLICA",
    //   "database_name": "looms-shuttle-replica",
    //   "database_id": "<id>",
    // },
  ],
  // Media people attach to messages and media agents make. Local dev keeps the objects on disk
  // under `.wrangler`; add `"remote": true` to read and write the real bucket instead. Create
  // the bucket with `wrangler r2 bucket create shuttle-local`.
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "shuttle-local",
    },
  ],
  // For real Linux sandboxes (Docker required for `wrangler dev`).
  // Enables Terminal (PTY) and Browser (getTcpPort) artifact tabs.
  // durable_object policy uses a named `images` map; start with ctx.container.images.base.
  "containers": [
    {
      "class_name": "SessionSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "../../packages/sandbox/Dockerfile",
        },
      },
    },
  ],
}
