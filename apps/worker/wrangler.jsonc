{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuttle",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "LOOMS_MODEL": "anthropic/claude-sonnet-5.5",
    "SHUTTLE_WORKSPACE_MODE": "memory",
    "SHUTTLE_PLAYBOOK_RUN_ID": "shuttle-playbook",
    "SHUTTLE_WORKSPACE_RUN_ID": "shuttle-workspace",
    "SHUTTLE_PULLS_RUN_ID": "shuttle-pulls",
    "SHUTTLE_WEB_URL": "http://127.0.0.1:5180",
    // Hostname used for container preview iframes (`p3000-<folderId>.<host>`).
    // Locally, `*.localhost` resolves to loopback; production needs wildcard DNS.
    "SHUTTLE_PREVIEW_HOST": "localhost",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOOMS_RUN",
        "class_name": "LoomsRun",
      },
      {
        "name": "SANDBOX",
        "class_name": "SessionSandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LoomsRun", "SessionSandbox"],
    },
  ],
  // Uncomment and create a D1 database for cross-run session lists and history tools:
  // "d1_databases": [
  //   {
  //     "binding": "REPLICA",
  //     "database_name": "looms-shuttle-replica",
  //     "database_id": "<create with: wrangler d1 create looms-shuttle-replica>",
  //   },
  // ],
  // For real Linux sandboxes (Docker required for `wrangler dev`).
  // Enables Terminal (PTY) and Browser (getTcpPort) artifact tabs.
  // durable_object policy uses a named `images` map; start with ctx.container.images.base.
  "containers": [
    {
      "class_name": "SessionSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
        },
      },
    },
  ],
}
