{
  "name": "@shuttle/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare-hosted Looms coding harness (Shuttle)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790 --inspector-port 9229",
    "dev:tunnel": "bun --env-file=.dev.vars scripts/dev-tunnel.ts",
    "deploy": "bun run --cwd ../web build && bun scripts/deploy-config.ts && wrangler deploy --config wrangler.deploy.jsonc",
    "build": "bun x tsc -p tsconfig.json --noEmit",
    "check-types": "bun x tsc -p tsconfig.json --noEmit",
    "test": "bun test src scripts",
    "deploy:config": "bun run --cwd ../web build && bun scripts/deploy-config.ts"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "^3.0.35",
    "@cloudflare/sandbox": "^1.0.3",
    "@daytona/sdk": "^0.231.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@pierre/sdk": "^0.1.2",
    "@shuttle/api": "workspace:*",
    "@shuttle/core": "workspace:*",
    "@shuttle/engine": "workspace:*",
    "@shuttle/git": "workspace:*",
    "@shuttle/runner-protocol": "workspace:*",
    "@shuttle/sandbox": "workspace:*",
    "@swirls/looms": "0.19.0",
    "ai": "^7.0.0",
    "better-auth": "^1.7.23",
    "effect": "4.1.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/openapi-client": "1.16.2",
    "cloudflared": "^0.7.3",
    "typescript": "7.0.2",
    "wrangler": "^4.131.2"
  }
}
