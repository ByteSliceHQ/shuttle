# Copy to .dev.vars for local wrangler dev.
OPENROUTER_API_KEY=
LOOMS_MODEL=anthropic/claude-sonnet-5.5

# TypeSafe Jev for Looms evaluator decisions (intake routing).
# Create a key at https://typesafe.ai — without it, intake uses local heuristics.
TYPESAFE_AI_API_KEY=
# Optional; defaults to jev-latest
# JEV_MODEL=jev-latest

SHUTTLE_WORKSPACE_MODE=memory
SHUTTLE_PLAYBOOK_RUN_ID=shuttle-playbook
SHUTTLE_WORKSPACE_RUN_ID=shuttle-workspace
SHUTTLE_PULLS_RUN_ID=shuttle-pulls
SHUTTLE_WEB_URL=http://127.0.0.1:5180

# GitHub App (optional — enables Connect GitHub + private repos + PRs)
# Use a personal *dev* App: `bun run dev` overwrites its webhook URL with a
# Cloudflare quick tunnel on every start. Any placeholder webhook URL is fine
# at creation; keep "Active" checked. Convert the downloaded PEM:
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in app.pem
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Optional user/PAT. Auto-filled from `gh auth token` by `bun run dev` when empty.
# Used when the App lacks Pull requests / Checks / Commit statuses so private
# inbox sync and PR create still work locally.
GITHUB_TOKEN=
# Auto-filled by `bun run dev` when empty; also pushed to the App hook config.
GITHUB_STATE_SECRET=
GITHUB_WEBHOOK_SECRET=

# Encrypts stored coding agent subscription credentials. Auto-filled by `bun run dev`
# when empty. Changing it makes existing connections unreadable.
SHUTTLE_CREDENTIALS_KEY=

# Signs sign-in sessions. Auto-filled by `bun run dev` when empty. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# The GitHub App's client id and secret. With them, Connect GitHub identifies the person and
# links the installations they can access, including ones that already exist; without them only
# a fresh install can be linked. They also enable "Sign in with GitHub".
# Add both of these as callback URLs on the App:
#   <SHUTTLE_WEB_URL>/github/callback            (connecting GitHub)
#   <SHUTTLE_WEB_URL>/api/auth/callback/github   (signing in with GitHub)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Per-user sandboxes run on Daytona (https://app.daytona.io, Dashboard > Keys).
DAYTONA_API_KEY=
# Optional; default to Daytona's cloud and your account's default region.
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# The image with the agent CLIs and the bridge. Build it with
#   bun --env-file=.dev.vars scripts/daytona-snapshot.ts shuttle-agents
# DAYTONA_SNAPSHOT=shuttle-agents

# Repositories are served to sandboxes by Code Storage (https://code.storage). Create a key on
# the organization's Keys page; it shows the organization name and the private key once.
# Paste the PEM on one line with \n for line breaks, or as a quoted multi-line value.
PIERRE_ORG=
PIERRE_PRIVATE_KEY=

# Set to `off` to skip the Cloudflare quick tunnel (inbox Sync still works).
# SHUTTLE_TUNNEL=off
