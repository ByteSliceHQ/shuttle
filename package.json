{
  "name": "shuttle",
  "version": "0.0.1",
  "private": true,
  "description": "Looms-powered coding harness",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-setup.ts && turbo run dev dev:tunnel",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint . --type-aware --deny-warnings --report-unused-disable-directives",
    "verify": "turbo run check-types test && bun run lint && bun run fmt:check",
    "desktop": "bun run --cwd apps/desktop start",
    "changeset": "changeset",
    "check:changeset": "bun run scripts/check-changeset.ts",
    "version-packages": "changeset version && bun install --lockfile-only && oxfmt packages/shuttle/CHANGELOG.md",
    "check:package": "bun run scripts/check-package.ts",
    "release": "bun run scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@oxlint/plugins": "1.93.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "^1.4.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "electron"
  ]
}
