{
  "name": "shuttle",
  "version": "0.0.1",
  "private": true,
  "description": "Looms-powered coding harness",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-setup.ts && turbo run dev dev:tunnel",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint . --deny-warnings && bun run lint:deprecated",
    "lint:deprecated": "oxlint apps packages --type-aware -A all -D typescript/no-deprecated",
    "verify": "turbo run check-types test && bun run lint && bun run fmt:check",
    "desktop": "bun run --cwd apps/desktop start"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "^1.3.9",
    "oxfmt": "0.67.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron"
  ]
}
